# Copy to .env.local and fill in. .env.local is gitignored.

# --- LLM via Vercel AI Gateway (routes to Claude) ---
AI_GATEWAY_API_KEY=

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Gmail API (throwaway Google account) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
HONEYPOT_EMAIL=

# --- Vapi (voice) ---
VAPI_API_KEY=
VAPI_WEBHOOK_SECRET=

# --- Cron auth (any random string; set the same in Vercel cron header) ---
CRON_SECRET=

# Safety gate for the poller. Default requires a "honeypot" Gmail label.
GMAIL_QUERY=label:honeypot is:unread
